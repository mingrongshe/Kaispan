# 应用连数据库用的连接串。
#
# 本地有两条路，两条都用 127.0.0.1:55432，所以这一行不用改：
#   docker compose up -d db   用 Docker 起 postgres 17（推荐）
#   pnpm pg:start             用 npm 包里自带的 postgres 二进制起一个（机器上没 Docker 时）
#
# 换成任何一个外部 PostgreSQL（Supabase、Neon、自建）也一样能跑，
# tools/pg.mjs 认出地址不是本机就会让路，不会再起本地数据库。
#
# 上 Supabase 时这里填 "Connection pooling" 那条（端口 6543，transaction 模式），
# 应用是无状态短连接，走池子才不会把连接数打满。
# SSL 先用 verify-full；报证书链不可信再看 docs/deploy.md 第一节，那里写了两条退路。
#   postgresql://postgres.<ref>:<密码>@aws-0-<区域>.pooler.supabase.com:6543/postgres?sslmode=verify-full
DATABASE_URL="postgresql://kaispan:kaispan@127.0.0.1:55432/haccp?schema=public"

# 打 migration 和灌演示数据用的直连串。本地不用填。
# Supabase 上填控制台里的 "Direct connection"（端口 5432）。
# 为什么必须分开：transaction pooler 一条语句一个事务、不保证会话粘性，
# DDL 和 advisory lock 在上面不可靠，见 tools/migrate.mjs 里的说明。
# DIRECT_DATABASE_URL="postgresql://postgres:<密码>@db.<ref>.supabase.co:5432/postgres?sslmode=verify-full"

# 集成测试用的独立库，会被反复清空，不要指向开发库，更不要指向线上。
TEST_DATABASE_URL="postgresql://kaispan:kaispan@127.0.0.1:55432/haccp_test?schema=public"

# 后端监听的端口。Railway 会自己注入 PORT，那边不用手工设。
PORT=3001

# 后端监听的网卡。本地留空就是只听 127.0.0.1（不暴露到局域网）；
# 容器里必须是 0.0.0.0，apps/api/Dockerfile 里已经设好了。
# HOST=0.0.0.0

# 允许带 cookie 访问后端的前端地址（CORS）。
# 浏览器其实不直接访问后端（业务数据都由前端的服务端转发），这条只是兜底。
WEB_ORIGIN="http://127.0.0.1:3000"

# 前端访问后端的地址。前端只在服务端读它，浏览器里不出现。
# 上线后填 Railway 给 API 的地址，例如 https://haccp-api-production.up.railway.app
API_BASE_URL="http://127.0.0.1:3001"

# 上传文件落盘目录（第一版本地磁盘，正式接入换对象存储）。
# Railway 上要挂一块持久卷到这个路径，否则每次部署照片都没了。镜像里默认是 /data/storage。
FILE_STORAGE_DIR="./.storage"

# 只有在拿不到 binaries.prisma.sh 时才需要（例如出口有白名单）。
# prisma generate 会先确保 schema-engine 二进制存在；本仓库不用 prisma migrate
# （migration 走 tools/migrate.mjs），所以给它一个存在的文件就够，不会被执行。
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/true
